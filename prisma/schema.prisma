generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  folders          Folder[]
  notes            Note[]
  tags             Tag[]
  attachments      Attachment[]
  flashcardReviews FlashcardReview[]
}

/**
 * Estágio de maturidade da nota, inspirado no método Zettelkasten:
 * a nota nasce como captura rápida (FLEETING) e é "promovida" conforme
 * amadurece — primeiro pra algo ancorado numa fonte (LITERATURE), depois
 * pra uma ideia atômica e conectada, em texto próprio (PERMANENT).
 */
enum NoteType {
  FLEETING
  LITERATURE
  PERMANENT
}

/**
 * As 4 categorias do método PARA (Tiago Forte): Projetos, Áreas, Recursos,
 * Arquivo. Marcam as 4 pastas-raiz que todo usuário ganha automaticamente —
 * null em qualquer outra pasta (criada livremente pelo usuário).
 */
enum ParaCategory {
  PROJECTS
  AREAS
  RESOURCES
  ARCHIVE
}

model Folder {
  id           String        @id @default(cuid())
  name         String
  parentId     String?
  parent       Folder?       @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children     Folder[]      @relation("FolderToFolder")
  /**
   * Só preenchido nas 4 pastas-raiz do PARA — ver enum ParaCategory.
   */
  paraCategory ParaCategory?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes        Note[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, paraCategory])
  @@index([userId])
  @@index([parentId])
}

model Note {
  id        String    @id @default(cuid())
  title     String
  content   Json
  plainText String    @default("")
  type      NoteType  @default(FLEETING)
  /**
   * Preenchido só pras notas diárias (uma por dia por usuário); null pro resto.
   */
  dailyDate DateTime? @db.Date
  folderId  String?
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tags        NoteTag[]
  attachments Attachment[]

  linksOut NoteLink[] @relation("SourceNote")
  linksIn  NoteLink[] @relation("TargetNote")

  flashcardReviews FlashcardReview[]

  @@unique([userId, dailyDate])
  @@index([userId])
  @@index([folderId])
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  NoteTag[]

  @@unique([userId, name])
  @@index([userId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model NoteLink {
  id           String @id @default(cuid())
  sourceNoteId String
  targetNoteId String
  source       Note   @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  target       Note   @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId])
  @@index([targetNoteId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  r2Key     String
  mimeType  String
  size      Int
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([userId])
}

/**
 * Estado de repetição espaçada (SM-2 simplificado) de UM flashcard dentro de
 * uma nota. `cardKey` é o identificador estável do card — o attrs.id do bloco
 * de flashcard, ou (pra sintaxe legada "Pergunta >> Resposta", que não tem
 * onde guardar um id) um hash da pergunta. Sem linha aqui = card nunca
 * revisado = já está "devido" pra revisão.
 */
model FlashcardReview {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId         String
  note           Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  cardKey        String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([noteId, cardKey])
  @@index([userId, dueAt])
}
