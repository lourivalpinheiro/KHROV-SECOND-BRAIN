generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes            Note[]
  tags             Tag[]
  attachments      Attachment[]
  flashcardReviews FlashcardReview[]
  healthProfile        HealthProfile?
  healthDays           HealthDay[]
  healthProfileHistory HealthProfileHistory[]
  healthSleepDays      HealthSleepDay[]

  financeProfile         FinanceProfile?
  financeEntries         FinanceEntry[]
  financeTags            FinanceTag[]
  financeBudgetVariables FinanceBudgetVariable[]
  financeSavingsPockets  FinanceSavingsPocket[]
}

/**
 * Pipeline de maturação cognitiva da nota (arquitetura neurobiológica):
 * Estímulo (captura crua) → Potenciação (maturação, cruza referências) →
 * Sinapse (domínio lógico, síntese com as próprias palavras) → Engrama
 * (consolidação, validada por flashcards de evocação ativa). Cada salto
 * tem uma trava de fricção — ver src/lib/note-types.ts.
 */
enum NoteType {
  /**
   * Rascunho de sessão (Córtex) — não faz parte do pipeline de promoção.
   * Só vira Estímulo de verdade quando um trecho é extraído dela.
   */
  CORTEX
  STIMULUS
  POTENTIATION
  SYNAPSE
  ENGRAM
}

model Note {
  id            String    @id @default(cuid())
  title         String
  content       Json
  plainText     String    @default("")
  type          NoteType  @default(STIMULUS)
  /**
   * Premissa fundamental escrita pelo usuário, com as próprias palavras —
   * exigida pra promover de Potenciação a Sinapse (trava de fricção).
   */
  synthesisText String?
  /**
   * Preenchido só pras notas diárias (uma por dia por usuário); null pro resto.
   */
  dailyDate     DateTime? @db.Date
  /**
   * Lixeira: null = nota ativa. Preenchido = foi excluída (soft delete) e
   * some de todas as listas normais (notas, busca, flashcards, grafo), mas
   * continua no banco por 30 dias — o cron de src/app/api/cron/purge-trash
   * apaga de vez o que passou desse prazo sem ser restaurado.
   */
  deletedAt     DateTime?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tags        NoteTag[]
  attachments Attachment[]

  linksOut NoteLink[] @relation("SourceNote")
  linksIn  NoteLink[] @relation("TargetNote")

  flashcardReviews FlashcardReview[]

  @@unique([userId, dailyDate])
  @@index([userId])
  @@index([userId, deletedAt])
}

model Tag {
  id     String    @id @default(cuid())
  name   String
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes  NoteTag[]

  @@unique([userId, name])
  @@index([userId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model NoteLink {
  id           String @id @default(cuid())
  sourceNoteId String
  targetNoteId String
  source       Note   @relation("SourceNote", fields: [sourceNoteId], references: [id], onDelete: Cascade)
  target       Note   @relation("TargetNote", fields: [targetNoteId], references: [id], onDelete: Cascade)

  @@unique([sourceNoteId, targetNoteId])
  @@index([targetNoteId])
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  r2Key     String
  mimeType  String
  size      Int
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([userId])
}

/**
 * Estado de repetição espaçada (SM-2 simplificado) de UM flashcard dentro de
 * uma nota. `cardKey` é o identificador estável do card — o attrs.id do bloco
 * de flashcard, ou (pra sintaxe legada "Pergunta >> Resposta", que não tem
 * onde guardar um id) um hash da pergunta. Sem linha aqui = card nunca
 * revisado = já está "devido" pra revisão.
 */
model FlashcardReview {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId         String
  note           Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  cardKey        String
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([noteId, cardKey])
  @@index([userId, dueAt])
}

/**
 * Módulo Saúde — dados base pro cálculo de meta de água e estimativa de
 * calorias (regras gerais, não é orientação médica). waterGoalBottles é a
 * meta em garrafas de 1L (editável — sugerida a partir do peso, mas o
 * usuário pode fixar o número que quiser, ex: 4). gymPlanDays usa a mesma
 * convenção do Date.getDay() do JS (0=domingo..6=sábado), só pra
 * sugerir/destacar os dias planejados na tabela semanal — a tabela em si
 * mostra os 7 dias sempre, marcar um dia fora do plano não é bloqueado.
 */
model HealthProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg         Float
  heightCm         Float
  waterGoalBottles Int      @default(4)
  gymPlanDays      Int[]    @default([1, 3, 5])
  /** Meta de peso (opcional). O peso "de partida" fica congelado em
   * targetWeightBaselineKg no momento em que a meta é definida (ou muda),
   * pra saber se o objetivo é emagrecer ou ganhar peso e detectar quando
   * foi batida — ver src/lib/health.ts. */
  targetWeightKg         Float?
  targetWeightBaselineKg Float?
  targetWeightReachedAt  DateTime?
  /** Hora-alvo de dormir, em minutos desde meia-noite (ex: 23:00 = 1380) — ver /saude/sono. */
  targetBedtimeMinutes   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/**
 * Um registro por noite: que horas de fato foi dormir (minutos desde
 * meia-noite — madrugada, ex: 00:30, vira 30, continua "depois" das 23h
 * na hora de comparar/desenhar o gráfico, ver src/lib/health.ts).
 */
model HealthSleepDay {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  bedtimeMinutes Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/**
 * Um registro por dia: quantas garrafas de 1L de água (0..meta, marcadas
 * uma a uma), se foi pra academia, se tomou a suplementação, e as
 * observações do treino daquele dia (o "Córtex" da Saúde).
 */
model HealthDay {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  waterBottles Int      @default(0)
  gym          Boolean  @default(false)
  supplement   Boolean  @default(false)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/**
 * Um snapshot toda vez que o perfil de saúde é salvo (peso, altura, metas)
 * — histórico de longo prazo pra comparar evolução, já que a tabela da
 * semana em si reseta toda segunda. Só cresce, nunca é editado.
 */
model HealthProfileHistory {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg         Float
  heightCm         Float
  waterGoalBottles Int
  gymPlanDays      Int[]
  recordedAt       DateTime @default(now())

  @@index([userId, recordedAt])
}

/**
 * Ponto de partida do saldo de CAIXA — "eu tenho R$X hoje" — registrado
 * numa data. É o que a projeção/horizonte usa (ver src/lib/finance.ts).
 * Investimento não tem campo aqui de propósito: todo investimento precisa
 * estar dentro de um cofrinho (FinanceSavingsPocket com kind=INVESTMENT),
 * cada um com seu próprio saldo inicial — permite ter mais de um
 * investimento nomeado, não só um número solto.
 */
model FinanceProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingCashBalance Float    @default(0)
  startingBalanceDate DateTime @default(now()) @db.Date
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/**
 * Módulo Financeiro — entradas, saídas, economias, gasto do dia a dia
 * ("diário", contra o teto calculado em FinanceBudgetVariable) e cartão de
 * crédito. `amount` é sempre positivo; o sinal (soma/subtrai do saldo) é
 * decidido pelo `type` na hora de calcular (ver src/lib/finance.ts).
 */
enum FinanceEntryType {
  INCOME
  EXPENSE
  SAVINGS
  DAILY
  CREDIT_CARD
}

/** Recorrência simples — projeção futura expande isso sem materializar linha por ocorrência (ver src/lib/finance.ts). */
enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

/** Só importa quando `type` é SAVINGS: DEPOSIT tira do saldo disponível (guardando no cofrinho), WITHDRAWAL devolve pro saldo disponível (resgate do cofrinho). */
enum SavingsDirection {
  DEPOSIT
  WITHDRAWAL
}

/** SAVINGS = cofrinho comum (meta, reserva); INVESTMENT = onde todo investimento precisa morar — não existe saldo de investimento solto, sempre dentro de um cofrinho desses. */
enum PocketKind {
  SAVINGS
  INVESTMENT
}

/**
 * Um "cofrinho" — pote nomeado (ex: "Viagem", "Reserva", "Tesouro
 * Direto"). Lançamentos do tipo SAVINGS podem apontar pra um, e a página
 * dedicada do cofrinho (histórico + tabela) só olha os lançamentos dele.
 * `startingBalance`/`startingBalanceDate` são pro caso de já existir
 * dinheiro ali antes de começar a registrar (ex: já tinha R$5000
 * investidos) — o saldo do cofrinho é esse valor + depósitos − resgates.
 * Os três campos de meta são opcionais — preenchidos, o cofrinho também
 * aparece em /financeiro/metas com uma barra de progresso.
 */
model FinanceSavingsPocket {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  kind   PocketKind @default(SAVINGS)

  startingBalance     Float     @default(0)
  startingBalanceDate DateTime? @db.Date

  targetAmount        Float?
  targetDate          DateTime? @db.Date
  monthlyContribution Float?

  /**
   * Rentabilidade indexada ao CDI — só entra em ação quando os DOIS estão
   * preenchidos (ver /api/finance/pockets/[id]/cdi): cdiPercentage é
   * "110" pra "110% do CDI", maturityDate é o vencimento (a evolução para
   * de render depois dele, ou em hoje, o que vier primeiro).
   */
  cdiPercentage Float?
  maturityDate  DateTime? @db.Date

  entries   FinanceEntry[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

/**
 * Um lançamento financeiro. `date` é a data que impacta o saldo — pra
 * cartão de crédito, é o vencimento da fatura daquela parcela, não o dia
 * da compra. Parcelamento vira várias linhas com o mesmo
 * `installmentGroupId`, uma por vencimento (ver /api/finance/entries).
 */
model FinanceEntry {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          FinanceEntryType
  description   String
  amount        Float
  date          DateTime         @db.Date
  recurrence    RecurrenceType   @default(NONE)
  /** Null = recorrência sem data final (a projeção futura tem um teto de qualquer forma). */
  recurrenceEndDate DateTime?    @db.Date
  /** Ocorrências puladas (YYYY-MM-DD) — exclusão de "só essa ocorrência" numa série recorrente, sem mexer no resto. */
  excludedDates     String[]     @default([])

  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  /** Só usado quando type=SAVINGS — qual cofrinho recebe/perde o valor. */
  pocketId         String?
  pocket           FinanceSavingsPocket? @relation(fields: [pocketId], references: [id], onDelete: SetNull)
  savingsDirection SavingsDirection      @default(DEPOSIT)

  tags      FinanceEntryTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([installmentGroupId])
  @@index([pocketId])
}

model FinanceTag {
  id      String            @id @default(cuid())
  name    String
  userId  String
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FinanceEntryTag[]

  @@unique([userId, name])
  @@index([userId])
}

model FinanceEntryTag {
  entryId String
  tagId   String
  entry   FinanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  tag     FinanceTag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([entryId, tagId])
  @@index([tagId])
}

/**
 * Uma "variável" livre da previsão diária (nome + valor, o usuário define
 * quantas quiser) — a soma de todas dividida por 30 é o teto de gasto do
 * dia (ver dailyAllowance em src/lib/finance.ts). `order` só controla a
 * ordem de exibição.
 */
model FinanceBudgetVariable {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Float
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, order])
}
