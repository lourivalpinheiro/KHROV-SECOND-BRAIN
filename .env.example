# --- Banco de dados (Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Usuário único (seed) ---
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""

# --- Supabase (banco de dados + anexos) ---
# Service role / secret key — só no servidor, nunca prefixar com NEXT_PUBLIC_.
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Publishable/anon key — segura de expor no cliente (usada só pra
# completar o upload num signed URL já emitido pelo servidor).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Cloudflare R2 (legado — anexos migraram pro Supabase Storage acima) ---
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="thought-chain-attachments"
# R2_PUBLIC_URL=""
